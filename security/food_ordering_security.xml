<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_food_ordering" model="ir.module.category">
        <field name="name">Food Ordering</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_food_cashier" model="res.groups.privilege">
        <field name="name">Cashier</field>
        <field name="category_id" ref="food_ordering.module_category_food_ordering"/>
        <field name="sequence">10</field>
    </record>
    <record id="privilege_food_kitchen" model="res.groups.privilege">
        <field name="name">Kitchen</field>
        <field name="category_id" ref="food_ordering.module_category_food_ordering"/>
        <field name="sequence">20</field>
    </record>
    <record id="privilege_food_management" model="res.groups.privilege">
        <field name="name">Management</field>
        <field name="category_id" ref="food_ordering.module_category_food_ordering"/>
        <field name="sequence">30</field>
    </record>
    <record id="group_food_cashier" model="res.groups">
        <field name="name">Food Cashier</field>
        <field name="privilege_id" ref="food_ordering.privilege_food_cashier"/>
    </record>
    <record id="group_food_kitchen" model="res.groups">
        <field name="name">Food Kitchen</field>
        <field name="privilege_id" ref="food_ordering.privilege_food_kitchen"/>
    </record>
    <record id="group_food_manager" model="res.groups">
        <field name="name">Food Manager</field>
        <field name="privilege_id" ref="food_ordering.privilege_food_management"/>
        <field name="implied_ids" eval="[(4, ref('food_ordering.group_food_cashier')), (4, ref('food_ordering.group_food_kitchen'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
