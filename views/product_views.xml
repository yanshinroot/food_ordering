<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_food_ordering" model="ir.ui.view">
        <field name="name">product.template.form.food.ordering</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <group string="Food Ordering">
                    <field name="food_available_online"/>
                    <field name="food_is_beverage"/>
                    <field name="food_own_cup_eligible" invisible="not food_is_beverage"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
