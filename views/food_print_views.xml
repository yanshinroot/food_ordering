<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="food_print_job_list" model="ir.ui.view">
        <field name="name">food.print.job.list</field>
        <field name="model">food.print.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/><field name="order_id"/><field name="target"/><field name="state" widget="badge"/><field name="device_id"/><field name="attempts"/><field name="error_message"/>
                <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
            </list>
        </field>
    </record>
    <record id="action_food_print_jobs" model="ir.actions.act_window">
        <field name="name">Print Jobs</field><field name="res_model">food.print.job</field><field name="view_mode">list,form</field>
    </record>
    <record id="food_printer_device_list" model="ir.ui.view">
        <field name="name">food.printer.device.list</field><field name="model">food.printer.device</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="target"/><field name="connection_state" widget="badge" decoration-success="connection_state == 'online'" decoration-danger="connection_state == 'offline'"/><field name="queued_jobs"/><field name="failed_jobs" decoration-danger="failed_jobs &gt; 0"/><field name="printer_type"/><field name="printer_address"/><field name="last_seen_at"/><field name="active"/></list></field>
    </record>
    <record id="food_printer_device_form" model="ir.ui.view">
        <field name="name">food.printer.device.form</field><field name="model">food.printer.device</field>
        <field name="arch" type="xml"><form><header><button name="action_rotate_key" type="object" string="Rotate Device Key" class="btn-secondary" confirm="The connected Android app or print agent must be updated with the new key. Continue?"/></header><sheet><group><field name="name"/><field name="target"/><field name="device_key" password="True"/><field name="connection_state" widget="badge"/><field name="queued_jobs"/><field name="failed_jobs"/><field name="printer_type"/><field name="printer_address"/><field name="active"/><field name="last_seen_at" readonly="1"/></group></sheet></form></field>
    </record>
    <record id="action_food_printer_devices" model="ir.actions.act_window">
        <field name="name">Printer Devices</field><field name="res_model">food.printer.device</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_food_print_jobs" name="Print Jobs" parent="menu_food_root" action="action_food_print_jobs" sequence="20" groups="food_ordering.group_food_manager"/>
    <menuitem id="menu_food_printer_devices" name="Printer Devices" parent="menu_food_root" action="action_food_printer_devices" sequence="30" groups="food_ordering.group_food_manager"/>
</odoo>
