<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="food_device_pairing_list" model="ir.ui.view">
        <field name="name">food.device.pairing.list</field>
        <field name="model">food.device.pairing</field>
        <field name="arch" type="xml">
            <list decoration-muted="used" decoration-danger="not used and expires_at &lt; current_date">
                <field name="code"/><field name="role"/><field name="device_name"/><field name="branch"/>
                <field name="expires_at"/><field name="used"/><field name="device_id"/><field name="created_by_id"/>
                <button name="action_regenerate" type="object" string="Regenerate" invisible="not used"/>
            </list>
        </field>
    </record>
    <record id="food_device_pairing_form" model="ir.ui.view">
        <field name="name">food.device.pairing.form</field>
        <field name="model">food.device.pairing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_regenerate" type="object" string="Regenerate Code" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="role"/>
                        <field name="device_name"/>
                        <field name="branch"/>
                        <field name="expires_at"/>
                        <field name="used" readonly="1"/>
                        <field name="used_at" readonly="1"/>
                        <field name="device_id" readonly="1"/>
                        <field name="created_by_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_food_device_pairings" model="ir.actions.act_window">
        <field name="name">Device Pairing Codes</field>
        <field name="res_model">food.device.pairing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_role': 'cashier'}</field>
    </record>
    <menuitem id="menu_food_device_pairings" name="Device Pairing" parent="food_ordering.menu_food_root" action="action_food_device_pairings" sequence="31" groups="food_ordering.group_food_manager"/>
</odoo>
