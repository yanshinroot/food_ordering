<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="food_menu_category_list" model="ir.ui.view">
        <field name="name">food.menu.category.list</field>
        <field name="model">food.menu.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_food_menu_categories" model="ir.actions.act_window">
        <field name="name">Menu Categories</field>
        <field name="res_model">food.menu.category</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_food_menu_categories" name="Menu Categories" parent="food_ordering.menu_food_root" action="action_food_menu_categories" sequence="6" groups="food_ordering.group_food_manager"/>
</odoo>
